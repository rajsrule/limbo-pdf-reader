{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Limbo",
  "version": "0.1.1",
  "identifier": "io.github.rajsrule.limbo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Limbo",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 360,
        "decorations": false,
        "shadow": false,
        "backgroundColor": "#000000",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src ipc: http://ipc.localhost 'self'; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "reader"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "A quieter place to read PDFs",
    "longDescription": "An offline OLED PDF reader with image-preserving Smart Dark, highlights, comments, split reading, and Windows snapping.",
    "publisher": "rajsrule",
    "homepage": "https://github.com/rajsrule/limbo-pdf-reader",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../node_modules/pdfjs-dist/LICENSE": "licenses/PDFjs-LICENSE.txt",
      "../notices/": "notices/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerHooks": "installer/hooks.nsh",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Limbo"
      }
    }
  }
}
